---
import BaseHead from '../components/BaseHead.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts'

interface Props {
	title?: string
	description?: string
	image?: string
	ogTitle?: string
	hideFooter?: boolean
}

const { title, description, image, ogTitle, hideFooter = false } = Astro.props

import '@fontsource-variable/inter'
import '@fontsource-variable/jetbrains-mono'
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={title || SITE_TITLE}
			description={description || SITE_DESCRIPTION}
			image={image}
			ogTitle={ogTitle}
		/>
	</head>
	<body
		class="text-foreground bg-background font-light dark:text-foreground-dark dark:bg-background-dark transition-colors min-h-screen flex flex-col"
	>
		<Navbar title={SITE_TITLE} />
		<!-- Short pages (404, say) grow to fill the viewport so the footer sits at
		     the bottom of the screen instead of halfway up it. -->
		<div class="flex-1 flex flex-col">
			<slot />
		</div>
		{!hideFooter && <Footer />}
	</body>
</html>
