---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
	title="Page not found | Héctor Ramos"
	description="The page you're looking for wasn't found."
>
	<main
		class="app-container flex-1 flex flex-col gap-6 items-center justify-center text-center py-24"
	>
		<h1
			class="font-title text-9xl md:text-[128px] font-bold leading-none px-4 hero-title z-10"
		>
			404
		</h1>
		<p class="text-xl max-w-[480px]">
			The page you're looking for wasn't found. Please check the link again.
		</p>
		<a class="btn-primary" href="/">Go to Home Page</a>
	</main>
</BaseLayout>
