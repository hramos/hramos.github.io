---
import BaseLayout from '../layouts/BaseLayout.astro'
import { SITE_BASE, SocialLinks } from '../consts'
import { Icon } from 'astro-icon/components'
import Portrait from '../components/Portrait.astro'
---

<BaseLayout
	description="Héctor Ramos is a software engineer and the founder of Wallfacer. Previously React Native at Meta, and Parse."
>
	<main class="app-container pt-36 md:pt-44">
		<div
			class="grid lg:grid-cols-[minmax(0,1fr)_20rem] gap-12 lg:gap-16 items-start"
		>
			<div class="flex flex-col gap-6">
				<h1 class="text-5xl md:text-7xl font-bold leading-none">
					Héctor Ramos
				</h1>
				<p class="text-2xl md:text-3xl font-light leading-snug">
					I build developer tools. Right now that means <a
						class="text-primary dark:text-primary-dark underline underline-offset-4 decoration-2"
						href="https://wallfacer.ai/">Wallfacer</a
					>, where AI employees follow your team's process: you assign the
					recurring work, and your handbook tells them what comes next.
				</p>
				<p class="text-lg md:text-xl font-light leading-relaxed max-w-2xl">
					Twenty years across infrastructure, mobile, and AI. I spent a decade
					at Meta on React Native, and before that I was a founding engineer at
					Parse. I grew up in Puerto Rico and now live outside Scottsdale, where
					I point a telescope at the sky most clear nights.
				</p>
				<div class="flex flex-wrap gap-x-8 gap-y-3 pt-2">
					{
						SocialLinks.map((link) => (
							<a
								class="text-xl text-primary dark:text-primary-dark underline underline-offset-4"
								href={link.url}
								target="_blank"
								rel="noopener noreferrer"
							>
								{link.name}
							</a>
						))
					}
				</div>
			</div>
			<Portrait
				alt="Héctor Ramos"
				class="max-w-xs lg:max-w-none justify-self-start lg:justify-self-end"
			/>
		</div>
	</main>

	<!-- About and contact -->
	<section
		class="app-container py-24 md:py-32 grid lg:grid-cols-2 gap-16 lg:gap-10"
	>
		<div class="space-y-6">
			<h2 class="section-title">About Me</h2>
			<p class="text-lg max-w-xl pb-4">
				The longer version: where I have worked, what I studied, and how I got
				from a university computing lab in Puerto Rico to a backyard observatory
				in Arizona.
			</p>
			<a class="btn-secondary" href={`${SITE_BASE}/about`}
				>Go to About
				<Icon size={20} name="mdi:arrow-right" />
			</a>
		</div>
		<div class="space-y-6">
			<h2 class="section-title">Get in touch</h2>
			<p class="text-lg max-w-xl">
				Email is best, and I read everything. I am also on the social networks
				linked at the top of this page.
			</p>
			<div class="flex flex-wrap mt-auto space-x-4">
				<a class="btn-primary" href="mailto:hector@hectorramos.com"
					>Get in touch
					<Icon height={20} name="mdi:email" />
				</a>
			</div>
		</div>
	</section>
</BaseLayout>
