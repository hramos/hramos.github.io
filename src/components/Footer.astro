---
import { SocialLinks, WebsiteLinks, SITE_BASE } from '../consts'
import { Icon } from 'astro-icon/components'

const today = new Date()
---

<footer>
	<div
		class="app-container grid md:grid-cols-3 gap-12 py-16 border-t-2 border-foreground/50 dark:border-foreground-dark/50"
	>
		<div>
			<h3 class="font-semibold text-2xl">
				<a href={`${SITE_BASE}/`} class="block w-fit" aria-label="Home"
					>Héctor Ramos</a
				>
			</h3>
			<p class="mt-4 text-lg max-w-xs opacity-80">
				Software engineer and founder in Scottsdale, Arizona. Writing, gear
				notes, and pictures of the night sky.
			</p>
		</div>
		<div>
			<h3 class="font-semibold text-2xl">Links</h3>
			<div class="flex flex-wrap gap-4 mt-4">
				<a class="text-lg" href={`${SITE_BASE}/`}>Home</a>
				{
					WebsiteLinks.map((link) => (
						<a class="text-lg" href={`${SITE_BASE}/${link.url}`}>
							{link.name}
						</a>
					))
				}
				<a
					href={`${SITE_BASE}/rss.xml`}
					target="_blank"
					rel="noopener noreferrer"
					class="text-lg"
					aria-label="RSS Feed"
				>
					<Icon name="mdi:rss" class="w-6 h-6" />
				</a>
			</div>
		</div>
		<div>
			<h3 class="font-semibold text-2xl">Socials</h3>
			<div class="flex flex-wrap gap-4 mt-4">
				{
					SocialLinks.map((link) => (
						<a
							class="text-lg"
							href={link.url}
							target="_blank"
							rel="noopener noreferrer"
						>
							{link.name}
						</a>
					))
				}
			</div>
		</div>
	</div>
	<div class="app-container flex justify-between items-center pb-6 text-sm">
		<p class="opacity-60">&copy; {today.getFullYear()} Héctor Ramos</p>
	</div>
</footer>
