---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

interface Props {
	alt: string
	class?: string
}

const { alt, class: className } = Astro.props

// The portrait is optional: drop a file at src/assets/portrait.{jpg,jpeg,png}
// and it is picked up automatically. Until one exists the hero falls back to a
// monogram so it still has a visual anchor instead of a hole in the layout.
const portraits = import.meta.glob<{ default: ImageMetadata }>(
	'/src/assets/portrait.{jpeg,jpg,png,webp,avif}'
)
const portrait = Object.values(portraits)[0]
---

<div
	class:list={[
		'aspect-square w-full overflow-hidden rounded-2xl border border-foreground/10 dark:border-foreground-dark/10',
		className,
	]}
>
	{
		portrait ? (
			<Image
				src={portrait()}
				alt={alt}
				widths={[320, 480, 640]}
				sizes="(min-width: 1024px) 24rem, 60vw"
				class="h-full w-full object-cover"
			/>
		) : (
			<div
				class="flex h-full w-full items-center justify-center bg-surface dark:bg-surface-dark"
				aria-hidden="true"
			>
				<span class="font-mono text-6xl font-bold opacity-25">HR</span>
			</div>
		)
	}
</div>
