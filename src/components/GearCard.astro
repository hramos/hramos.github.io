---
import { Icon } from 'astro-icon/components'
import type { GearItem } from '../data/gear'

interface Props {
	item: GearItem
	category: string
}

const { item, category } = Astro.props
const Tag = item.url ? 'a' : 'div'
const linkProps = item.url
	? {
			href: item.url,
			target: item.url.charAt(0) === 'h' ? '_blank' : '_self',
		}
	: {}
---

<Tag
	class:list={[
		'group snap-start shrink-0 w-40 sm:w-44 no-underline',
		{ 'cursor-pointer': item.url },
	]}
	{...linkProps}
>
	<div
		class="aspect-square flex items-center justify-center rounded-2xl bg-foreground/5 dark:bg-foreground-dark/5 group-hover:bg-foreground/10 dark:group-hover:bg-foreground-dark/10 transition-colors"
	>
		<Icon
			name={`mdi:${item.icon}`}
			class="text-5xl opacity-40 group-hover:opacity-70 transition-opacity"
			aria-hidden
		/>
	</div>
	<p class="mt-3 text-base leading-snug">
		<span class="font-semibold">{category}</span><span class="opacity-40">
			/
		</span>{item.name}
	</p>
	{
		item.note && (
			<p class="mt-1 text-sm leading-snug opacity-50">{item.note}</p>
		)
	}
</Tag>