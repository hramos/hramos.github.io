---
import { SITE_BASE } from '@/consts'
import FormattedDate from './FormattedDate.astro'
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

const { post } = Astro.props

const blogImages = import.meta.glob<{ default: ImageMetadata }>(
	'/src/assets/blogimages/**/*.{jpeg,jpg,png,gif}'
)

const coverImagePath = `/src/assets/blogimages/${post.id}/cover.jpg`
const coverImage = blogImages[coverImagePath]

// Posts without a cover image fall back to a generated gradient, so every card
// starts with the same aspect-video block and cards stay aligned within a row.
// The hue comes from the post id, so a post always gets the same colour.
const fallbackHue =
	[...post.id].reduce((sum, char) => sum + char.charCodeAt(0), 0) % 360
const fallbackGradient = `linear-gradient(135deg, hsl(${fallbackHue} 45% 42%), hsl(${(fallbackHue + 45) % 360} 50% 22%))`
---

<a
	href={`${SITE_BASE}/blog/${post.id}/`}
	class="card-surface card-interactive flex flex-col h-full group overflow-hidden"
>
	{
		coverImage ? (
			<Image
				src={coverImage()}
				alt={post.data.title}
				class="w-full object-cover aspect-video"
			/>
		) : (
			<div
				class="flex items-center justify-center aspect-video"
				style={`background-image: ${fallbackGradient}`}
				aria-hidden="true"
			>
				<span class="font-mono text-5xl font-bold text-white/40">
					{post.data.title.charAt(0)}
				</span>
			</div>
		)
	}
	<div class="flex flex-col gap-3 p-5 h-full">
		<h4
			class="text-2xl font-semibold group-hover:text-primary dark:group-hover:text-primary-dark group-hover:underline transition-colors"
		>
			{post.data.title}
		</h4>
		<p class="line-clamp-3 opacity-80">
			{post.data.description}
		</p>
		<p class="uppercase text-sm mt-auto tracking-tight opacity-60">
			<FormattedDate date={post.data.pubDate} />
		</p>
	</div>
</a>
