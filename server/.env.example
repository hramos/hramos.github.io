# OpenAI API key. Leave blank to force mock mode (pass-through, no API calls).
OPENAI_API_KEY=

# Model used for interpretation.
PBJT_MODEL=gpt-4o-mini

# Port the server listens on.
PORT=8787

# Set to 1 to force mock mode even when an API key is present.
PBJT_MOCK=

# Comma-separated list of browser origins allowed to call the API.
# Unset -> https://hectorramos.com,https://www.hectorramos.com.
# localhost/127.0.0.1 on any port is ALWAYS allowed (dev). No-Origin
# (curl / server-to-server) requests are always allowed.
PBJT_ALLOWED_ORIGINS=

# Max requests per IP per minute before 429. Unset -> 20.
PBJT_RATE_LIMIT=
